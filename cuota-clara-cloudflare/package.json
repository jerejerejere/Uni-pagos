{
  "name": "cuota-clara-personal",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "check": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "deploy": "node scripts/deploy.mjs",
    "db:create": "wrangler d1 create cuota-clara",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:backup": "wrangler d1 export DB --remote --output backups/cuota-clara.sql"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "next": "16.3.4",
    "lucide-react": "1.31.0",
    "jose": "6.2.12"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
